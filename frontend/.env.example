# Copy to .env and fill in real values. Never commit the real .env file.
# Everything here ships to every visitor's browser — only put values here
# that are public by design (see CLAUDE.md non-negotiable #7).

# Backend API base URL. In local dev this is unused (Vite proxies /api to
# localhost:5100 instead — see vite.config.ts); set it for non-proxied
# environments.
VITE_API_BASE_URL=https://your-backend-host/api

# Google OAuth client ID (same value as backend's GOOGLE_CLIENT_ID). Client
# IDs are meant to be public — this is not a secret.
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
