{
  "name": "blackbox-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "cd frontend && npm run dev",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "build:prod": "cd frontend && npm run build:prod",
    "backend": "cd backend && node server.js",
    "deploy": "cd frontend && npm run deploy",
    "build:site": "npm run build:prod && rm -rf site-dist && mkdir -p site-dist/try-web && cp -R landing/. site-dist/ && cp -R frontend/dist/. site-dist/try-web/",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test": "npm run test:backend && npm run test:frontend && npm run test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "husky": "^9.1.7"
  }
}
