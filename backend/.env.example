# Copy to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string. Deliberately has no database name segment —
# do not add one; see CLAUDE.md non-negotiable #3.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/

# Symmetric secret used to sign/verify session JWTs. Must be a long random
# value — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<at least 32 random bytes, base64 or hex>

# Google OAuth client ID (from Google Cloud Console — same value used by
# frontend's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# AWS S3 bucket used for encrypted video storage.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<iam-user-access-key-id>
AWS_SECRET_ACCESS_KEY=<iam-user-secret-access-key>
S3_BUCKET_NAME=<bucket-name>

# Optional: caps the size (in bytes) a client is allowed to upload via a
# presigned POST. Defaults to 200MB if unset.
MAX_UPLOAD_BYTES=209715200

# Port the Express server listens on. Render sets this automatically in
# production; only needed for local runs.
PORT=5100

# Where emailed verification/reset links point (the frontend's origin).
# Defaults to the local dev server if unset.
FRONTEND_URL=http://localhost:8080

# SameSite mode for the session cookies. Defaults to 'lax', which works
# because the frontend and API share the blackb0x.app site. Only set
# 'none' if the frontend ever moves to a different site from the API.
# COOKIE_SAME_SITE=lax

# Local development only. No email provider is configured yet, so emails
# are stubbed. With this set to true, the stub prints each email —
# including its live verification/password-reset link — to the server log
# so you can click it locally. NEVER set this on Render or any real deploy:
# a reset link in a log is enough to take over that account.
# EMAIL_STUB_PRINT_LINKS=true

# Comma-separated list of origins allowed to call this API with
# credentials (CORS) and to pass the CSRF Origin/Referer check — see
# middleware/csrf.js. Leave unset to fall back to the hardcoded
# blackb0x.app origins. localhost is added automatically outside
# production regardless of this value, and is never added when
# NODE_ENV=production.
ALLOWED_ORIGINS=https://www.blackb0x.app,https://blackb0x.app
